{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200,http://localhost:4300"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_to_a_long_random_secret_at_least_32_chars",
    "Issuer": "smartops.auth",
    "Audience": "smartops.api",
    "ExpiryMinutes": 480
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/v1/auth/login"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/auth"
          }
        ]
      },
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Viewer",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/auth"
          }
        ]
      },
      "wells": {
        "ClusterId": "wells",
        "AuthorizationPolicy": "Viewer",
        "Match": {
          "Path": "/api/v1/wells/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/wells"
          }
        ]
      },
      "finance": {
        "ClusterId": "finance",
        "AuthorizationPolicy": "Viewer",
        "Match": {
          "Path": "/api/v1/finance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/finance"
          }
        ]
      },
      "workflow": {
        "ClusterId": "workflow",
        "AuthorizationPolicy": "Viewer",
        "Match": {
          "Path": "/api/v1/workflow/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/workflow"
          }
        ]
      },
      "reports": {
        "ClusterId": "reports",
        "AuthorizationPolicy": "Viewer",
        "Match": {
          "Path": "/api/v1/reports/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/reports"
          }
        ]
      },
      "reports-hub": {
        "ClusterId": "reports",
        "Match": {
          "Path": "/api/v1/hubs/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      },
      "integrations": {
        "ClusterId": "integrations",
        "AuthorizationPolicy": "Manager",
        "Match": {
          "Path": "/api/v1/integrations/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/integrations"
          }
        ]
      },
      "controlplane": {
        "ClusterId": "controlplane",
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/api/v1/controlplane/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/controlplane"
          }
        ]
      },
      "jenny": {
        "ClusterId": "jenny",
        "Match": {
          "Path": "/api/v1/jenny/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/jenny"
          }
        ]
      },
      "predictive": {
        "ClusterId": "predictive",
        "AuthorizationPolicy": "Viewer",
        "Match": {
          "Path": "/api/v1/predictive/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/predictive"
          }
        ]
      },
      "anomaly": {
        "ClusterId": "anomaly",
        "AuthorizationPolicy": "Viewer",
        "Match": {
          "Path": "/api/v1/anomaly/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/anomaly"
          }
        ]
      },
      "crew-opt": {
        "ClusterId": "crew",
        "AuthorizationPolicy": "Manager",
        "Match": {
          "Path": "/api/v1/crew-opt/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/crew-opt"
          }
        ]
      },
      "vision": {
        "ClusterId": "vision",
        "AuthorizationPolicy": "Manager",
        "Match": {
          "Path": "/api/v1/vision/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/vision"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://wmr_auth_1:7001/"
          }
        }
      },
      "wells": {
        "Destinations": {
          "d1": {
            "Address": "http://wmr_wells_1:7002/"
          }
        }
      },
      "finance": {
        "Destinations": {
          "d1": {
            "Address": "http://wmr_finance_1:7003/"
          }
        }
      },
      "workflow": {
        "Destinations": {
          "d1": {
            "Address": "http://wmr_workflow_1:7004/"
          }
        }
      },
      "reports": {
        "Destinations": {
          "d1": {
            "Address": "http://wmr_reports_1:7005/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:15:00"
        }
      },
      "integrations": {
        "Destinations": {
          "d1": {
            "Address": "http://wmr_integrations_1:7006/"
          }
        }
      },
      "controlplane": {
        "Destinations": {
          "d1": {
            "Address": "http://wmr_controlplane_1:7007/"
          }
        }
      },
      "jenny": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8001/"
          }
        }
      },
      "predictive": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8002/"
          }
        }
      },
      "anomaly": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8003/"
          }
        }
      },
      "crew": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8004/"
          }
        }
      },
      "vision": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8005/"
          }
        }
      }
    }
  }
}