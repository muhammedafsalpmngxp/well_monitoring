# ─── Database (MSSQL primary + TimescaleDB for time series) ──────────────────
MSSQL_SA_PASSWORD=YourStrong!Pass1
MSSQL_DB=smartops
MSSQL_HOST=localhost
MSSQL_PORT=1433

TIMESCALE_USER=smartops
TIMESCALE_PASSWORD=smartops
TIMESCALE_DB=smartops_ts
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432

# ─── Connection strings (auto-built from above for .NET services) ────────────
ConnectionStrings__Default=Server=localhost,1433;Database=smartops;User=sa;Password=CHANGE_ME;TrustServerCertificate=True;
ConnectionStrings__Timescale=Host=localhost;Port=5432;Database=smartops_ts;Username=smartops;Password=CHANGE_ME
# Control plane DB (separate from Default; consumed by SmartOps.ControlPlane on :7007)
ConnectionStrings__ControlPlane=Server=<host>,1433;Database=smartops_control_plain;User ID=<user>;Password=<password>;TrustServerCertificate=True;

# ─── Azure Entra ID (SSO). Leave blank in dev to use JWT-only login. ──────────
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=
AzureAd__ClientId=
AzureAd__Audience=
JwtSettings__SecretKey=dev-only-secret-please-change-32-bytes-minimum-length-string
JwtSettings__Issuer=smartops.auth
JwtSettings__Audience=smartops.api
JwtSettings__ExpiryMinutes=480

# ─── Redis (pub/sub, SignalR backplane, cache) ───────────────────────────────
Redis__ConnectionString=localhost:6379

# ─── Azure Service Bus (used by Workflow + Integrations) ─────────────────────
ServiceBus__ConnectionString=

# ─── CORS ────────────────────────────────────────────────────────────────────
Cors__AllowedOrigins=http://localhost:4200,http://localhost:4300

# ─── Service URLs (gateway routing) ──────────────────────────────────────────
Services__Auth=http://localhost:7001
Services__Wells=http://localhost:7002
Services__Finance=http://localhost:7003
Services__Workflow=http://localhost:7004
Services__Reports=http://localhost:7005
Services__Integrations=http://localhost:7006
Services__JennyAi=http://localhost:8001
Services__Predictive=http://localhost:8002
Services__Anomaly=http://localhost:8003
Services__CrewOptimizer=http://localhost:8004
Services__Vision=http://localhost:8005

# ─── Python services env ──────────────────────────────────────────────────────
OPENAI_API_KEY=
WHISPER_MODEL=small
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
