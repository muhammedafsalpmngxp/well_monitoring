# Copy to .env for local dev. NEVER commit .env (it is gitignored).
# In containers these are supplied as environment variables / ECS secrets,
# not via this file.

# ── Required ──────────────────────────────────────────────────────────────────
# main.py raises at startup if ETL_ENVIRONMENT != "development" and the key is unset.
ETL_ENVIRONMENT=development
ETL_INTERNAL_API_KEY=
CONTROL_PLANE_URL=http://localhost:7007

# ── Row limits ────────────────────────────────────────────────────────────────
# !! ETL_ROW_LIMIT defaults to "1" in code (extract.py) — ONE row per table.
#    Always set it explicitly for a real run. 0 = unlimited.
ETL_ROW_LIMIT=0
ETL_REF_ROW_LIMIT=0

# ── Logging ───────────────────────────────────────────────────────────────────
ETL_LOG_DIR=./logs
ETL_LOG_LEVEL=INFO

# ── SQL Server / ODBC ─────────────────────────────────────────────────────────
# Driver 18 defaults to Encrypt=yes; "no" preserves Driver 17 behaviour.
ETL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
ETL_ODBC_ENCRYPT=no

# ── CORS (read by shared/python/smartops_shared/app.py, comma-separated) ──────
Cors__AllowedOrigins=http://localhost:4200,http://localhost:4300

# ── Extraction tuning ─────────────────────────────────────────────────────────
ETL_PARALLEL_EXTRACT=
ETL_EXTRACT_WORKERS=
ETL_FETCH_BATCH_SIZE=
ETL_WATERMARK_COLUMN=
ETL_ENABLE_STREAMING=

# ── Load tuning ───────────────────────────────────────────────────────────────
ETL_ENABLE_BATCH_MODE=
ETL_BATCH_COMMIT_SIZE=
ETL_BATCH_INSERT_SIZE=
ETL_ENABLE_PRELOAD=
ETL_PRELOAD_DIR=
ETL_ENABLE_DEAD_LETTER=
ETL_DEAD_LETTER_DIR=

# ── Tracing ───────────────────────────────────────────────────────────────────
ETL_ENABLE_TRACE=

# ── Shared python location override (rarely needed) ───────────────────────────
# SMARTOPS_SHARED_PYTHON=/shared/python

# ── Per-source connection strings ─────────────────────────────────────────────
# Looked up dynamically as SOURCE_<conn_ref>, where <conn_ref> comes from the
# ControlPlane tenant-source record. Values should already be in ODBC form.
# SOURCE_EXAMPLE=DRIVER={ODBC Driver 18 for SQL Server};SERVER=host,1433;DATABASE=db;UID=user;PWD=pass;TrustServerCertificate=Yes
