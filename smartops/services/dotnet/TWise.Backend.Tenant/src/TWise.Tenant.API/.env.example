# Copy to .env for local `docker run --env-file .env` (gitignored).
# In ECS these are supplied as task-definition env vars / Secrets Manager instead.
# .NET reads Section__Key-shaped env vars automatically (WebApplication.CreateBuilder
# includes AddEnvironmentVariables() by default) and they override appsettings.json.

ConnectionStrings__TenantDb=Server=<host>,1433;Database=smartops_tenant_TNT-1000;User ID=<user>;Password=<password>;TrustServerCertificate=True;
ConnectionStrings__LegacyWellsDb=Server=<host>,1433;Database=AppMasterDB_UAT;User ID=<user>;Password=<password>;TrustServerCertificate=True;
ConnectionStrings__AlTasnimBI=Server=<host>,1433;Database=AlTasnimBI;User ID=<user>;Password=<password>;TrustServerCertificate=True;
