{
  "AllowedHosts": "*",
  "Service": { "Name": "TWise.Backend.ControlPlane" },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "TWise.Backend.ControlPlane.Application.Common.Behaviors.CachingBehavior": "Debug"
    
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "service": "controlplane"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {service} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/controlplane-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {service} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "ControlPlane": "Server=localhost,1433;Database=smartops_control_plane_qa;User ID=changeme;Password=CHANGE_ME;TrustServerCertificate=True;",
    "LegacyDirectory": "Server=localhost,1433;Database=AlTasnimBI;User ID=changeme;Password=CHANGE_ME;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_to_a_long_random_secret_at_least_32_chars",
    "Issuer": "smartops.auth",
    "Audience": "smartops.api",
    "ExpiryMinutes": 480
  },
  "InternalApi": {
    "ApiKey": "CHANGE_ME_to_a_long_random_secret_at_least_32_chars"
  },
  "AzureAd": { "Instance": "https://login.microsoftonline.com/", "TenantId": "", "ClientId": "", "Audience": "" },
  "Cors": { "AllowedOrigins": "http://localhost:4200,http://localhost:4300,http://localhost:7000,https://twise.prod-app.in,https://twise-qa-ui.prod-app.in,https://twise-demo-ui.prod-app.in" },
  "Provisioning": {
    "TargetServer": "localhost,1433",
    "AdminUser": "changeme",
    "AdminPassword": "CHANGE_ME_to_a_long_random_secret_at_least_32_chars",
    "DatabasePrefix": "smartops_tenant_TNT-1000",
    "MaxRetries": 5,
    "SchemaScriptPath": "sql/init-tenant-schema.sql",
    "TrustServerCertificate": true
  }
}