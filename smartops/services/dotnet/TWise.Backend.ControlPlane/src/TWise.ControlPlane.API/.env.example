# Copy to .env for local `docker run --env-file .env` (gitignored).
# In ECS these are supplied as task-definition env vars / Secrets Manager instead.
# .NET reads Section__Key-shaped env vars automatically (WebApplication.CreateBuilder
# includes AddEnvironmentVariables() by default) and they override appsettings.json.

ConnectionStrings__ControlPlane=Server=<host>,1433;Database=smartops_control_plane_qa;User ID=<user>;Password=<password>;TrustServerCertificate=True;
ConnectionStrings__LegacyDirectory=Server=<host>,1433;Database=AlTasnimBI;User ID=<user>;Password=<password>;TrustServerCertificate=True;

Provisioning__TargetServer=<host>,1433
Provisioning__AdminUser=<user>
Provisioning__AdminPassword=<password>
