# ═══════════════════════════════════════════════════════════════════════════
# SmartOps — Control Plane DB connection TEMPLATE
# Copy to controlplane.env and fill in real values. controlplane.env is gitignored.
# This DB is intentionally separate from the existing Default / AppMasterDB config.
# ═══════════════════════════════════════════════════════════════════════════

CONTROLPLANE_SERVER=<host>,1433
CONTROLPLANE_DATABASE=smartops_control_plain
CONTROLPLANE_USER=<user>
CONTROLPLANE_PASSWORD=<password>
CONTROLPLANE_TRUST_CERT=true

# Full connection string for a future .NET control-plane service
ConnectionStrings__ControlPlane=Server=<host>,1433;Database=smartops_control_plain;User ID=<user>;Password=<password>;TrustServerCertificate=True;
